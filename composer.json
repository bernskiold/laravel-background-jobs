{
    "name": "bernskiold/laravel-background-jobs",
    "description": "Track queued work as background jobs: status, owner, logs and notifications, with bulk runs that report one outcome for many jobs.",
    "keywords": [
        "bernskiold",
        "laravel",
        "queue",
        "jobs",
        "background-jobs",
        "progress",
        "livewire"
    ],
    "homepage": "https://github.com/bernskiold/laravel-background-jobs",
    "license": "MIT",
    "authors": [
        {
            "name": "Bernskiold",
            "email": "hello@bernskiold.com",
            "role": "Developer"
        },
        {
            "name": "Erik Bernskiöld",
            "email": "erik@bernskiold.com",
            "homepage": "https://bernskiold.com",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "illuminate/broadcasting": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/notifications": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "livewire/livewire": "^3.0 || ^4.0",
        "nunomaduro/collision": "^8.0 || ^9.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "livewire/livewire": "Required to use the headless Livewire components for the job list, the job detail page, the jobs in a run and the jobs of a model."
    },
    "autoload": {
        "psr-4": {
            "Bernskiold\\LaravelBackgroundJobs\\": "src/",
            "Bernskiold\\LaravelBackgroundJobs\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bernskiold\\LaravelBackgroundJobs\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bernskiold\\LaravelBackgroundJobs\\LaravelBackgroundJobsServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=2G"
    }
}
